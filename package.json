{
  "name": "assistente-analitico-neo4j",
  "version": "1.0.0",
  "description": "Assistente acad\u00eamico para an\u00e1lise de vendas com LangGraph e Neo4j",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file=.env src/index.ts",
    "dev": "node --watch --env-file=.env src/index.ts",
    "test": "node --test tests/*.test.ts",
    "seed": "node --env-file=.env data/seed.ts",
    "docker:infra:up": "docker compose up -d",
    "docker:infra:down": "docker compose down",
    "docker:infra:logs": "docker compose logs -f",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "neo4j",
    "langgraph",
    "openrouter",
    "sales-analytics"
  ],
  "author": "erickwendel",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@langchain/community": "^1.1.17",
    "@langchain/core": "^1.1.27",
    "@langchain/openai": "^1.2.9",
    "fastify": "^5.7.4",
    "langchain": "^1.2.25",
    "neo4j-driver": "^5.28.0",
    "@langchain/langgraph": "1.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.4.0",
    "@types/node": "^24.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
